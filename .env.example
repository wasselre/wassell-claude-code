VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps JS API key — powers the Maps view (third record view type).
# Get one at https://console.cloud.google.com/apis/credentials with the
# Maps JavaScript API enabled. Free tier: 28k map loads/month.
# When unset, the Maps view shows an in-app setup message instead of a map.
VITE_GOOGLE_MAPS_API_KEY=

# tldraw SDK license key — enables the Whiteboard page (/whiteboard) in
# production. Without a valid, domain-matched key tldraw unmounts its
# editor after 5 seconds on any non-localhost hostname. Localhost is
# always treated as development so local dev needs nothing here.
# Get a key: https://tldraw.dev/get-a-license/trial (100-day trial, free)
# or https://tldraw.dev/get-a-license/hobby (adds "Made with tldraw"
# watermark) or commercial (contact tldraw sales).
VITE_TLDRAW_LICENSE_KEY=

# ─── Chats module (WhatsApp via Haberchat) ────────────────────────────
# Server-side only. Never prefix with VITE_ — these must NOT bundle into
# the browser. Used by api/haberchat/* and api/webhook/haberchat.ts.

# Haberchat account API token — https://haber.chat → API keys.
HABERCHAT_TOKEN=

# Default Haberchat device id (24-hex). Optional — the /settings/whatsapp-
# numbers page lets admin pick from connected devices and overrides this.
HABERCHAT_DEFAULT_DEVICE_ID=

# Shared secret sent by Haberchat on every webhook event in an X-Webhook-
# Secret header. Generate with: openssl rand -hex 32
HABERCHAT_WEBHOOK_SECRET=

# Same project URL as VITE_SUPABASE_URL, but server-side accessible.
# The Vercel functions in api/* use this (not the VITE_ one).
SUPABASE_URL=

# Same anon key as VITE_SUPABASE_ANON_KEY, but server-side accessible.
# Used by api/_lib/auth.ts to verify Supabase JWTs on incoming requests.
SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. USED ONLY by api/webhook/haberchat.ts
# and api/webhook/hatif-call.ts (write on behalf of any user). Treat like
# root password. Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Calls module (Hatif / Voxa voice platform) ───────────────────────
# Server-side only. Never prefix with VITE_.
# Used by api/_lib/hatif.ts and api/webhook/hatif-call.ts.
#
# Setup:
#   1. Fill in HATIF_CLIENT_ID + HATIF_CLIENT_SECRET (from Hatif team).
#   2. Pick a channel (curl GET /v1/channels/service-account) and paste
#      its id as HATIF_DEFAULT_CHANNEL_ID — or leave blank if callers
#      always specify one.
#   3. Generate HATIF_WEBHOOK_SECRET (openssl rand -hex 32) and email
#      Hatif support with BOTH:
#         a. The webhook URL to set on each channel:
#            https://<your-domain>/api/webhook/hatif-call
#         b. The secret value so they enable HMAC-SHA256 signing
#            (X-Voxa-Signature header on every POST).
#      During initial setup you can let Hatif use ?secret=<HATIF_WEBHOOK_SECRET>
#      on the URL instead of HMAC — the webhook handler accepts either.

# OAuth2 client credentials for POST /connect/token (scope=VoxaAPI).
HATIF_CLIENT_ID=
HATIF_CLIENT_SECRET=

# Default Hatif channel id (UUID). Optional — callers may pick a channel
# at request time. Blank in most deployments.
HATIF_DEFAULT_CHANNEL_ID=

# Shared secret Hatif signs/sends on every post-call webhook event.
# Generate with: openssl rand -hex 32
HATIF_WEBHOOK_SECRET=

# ─── AI Agent module (internal Claude-powered sales assistant) ────────
# Server-side only. Never prefix with VITE_.
# Used by api/agent.ts to call the Anthropic Messages API.
# Obtain from https://console.anthropic.com/settings/keys.
# Required for the AI Agent chat (/model/ai_chats); the endpoint returns
# 500 "ANTHROPIC_API_KEY is not configured" when missing.
ANTHROPIC_API_KEY=

# ─── Research Project routine (Claude Code remote routine) ────────────
# Server-side only. Never prefix with VITE_ — these would leak the OAuth
# token into the browser bundle.
# Powers the "Research Project" button on All Projects records, which
# fires a pre-configured Claude Code routine that builds a 2 km market-
# study record in the CRM. See api/research-project.ts.
#
# Setup:
#   1. Create the routine at https://claude.com/code → Routines.
#   2. In the routine's settings, click the copy icon next to "API
#      trigger enabled" to copy the trigger URL — paste it here.
#   3. Generate an OAuth token (sk-ant-oat01-...) from the same page and
#      paste it as CLAUDE_ROUTINE_TOKEN. Treat like a password.
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=

# ─── Marketing Operations (fal.ai nano-banana-pro/edit, "Nano Banana 2") ─
# Server-side only. Never prefix with VITE_.
# Used by api/_lib/imageGen.ts + api/marketing/generate.ts. Each
# Generate Design click runs three sequential edit passes via Google's
# Gemini 3 Pro Image (Nano Banana 2) hosted on fal.ai:
#   1. cleanup (raw photo → cleaned photo)
#   2. editing (cleaned photo → new camera angle)
#   3. design  (edited photo + reference layout + logo → final design)
# Get an API key at https://fal.ai/dashboard/keys.
#
# Stub mode: set FAL_KEY=stub to skip the network entirely and return
# canned URLs after a 2s sleep — required for offline dev and CI.
FAL_KEY=

# Defaults: https://queue.fal.run and fal-ai/nano-banana-pro/edit.
# Override FAL_MODEL_ID to swap models (e.g. fal-ai/nano-banana/edit
# for the v1 model, or any other fal.ai image-edit model with the
# same { prompt, image_urls[] } request shape).
FAL_BASE_URL=
FAL_MODEL_ID=

# Image Chats composer model picker (api/_lib/imageGen.ts → resolveChatModelSlug).
# The chat composer lets the user pick between Nano Banana 2 and GPT Image 2.
# These two env vars let you re-point each option to a different fal endpoint
# without a code change. Defaults below are the production slugs.
#   FAL_CHAT_MODEL_ID            → default for 'nano-banana' (fal-ai/nano-banana-pro/edit)
#   FAL_CHAT_GPT_IMAGE_2_MODEL_ID → default for 'gpt-image-2' (openai/gpt-image-2/edit)
FAL_CHAT_MODEL_ID=
FAL_CHAT_GPT_IMAGE_2_MODEL_ID=

# Listing Message photo cleaning (api/_lib/imageGen.ts → imageGenTextRemoval,
# worker/src/runCleanTextJob.ts). Removes ALL overlay text/banners/logos/
# watermarks from a listing photo while keeping the building. Uses FLUX.2 klein
# 4B edit (instructable, ~3 s + ~$0.005/photo) — the dedicated text-removal model
# left big stylized banners, Gemini refuses watermark removal as "unsafe
# content", and GPT Image 2 worked but at ~3 min + ~$0.02–0.22/photo.
#   FAL_CLEAN_TEXT_MODEL_ID → default fal-ai/flux-2/klein/4b/edit
#   FAL_CLEAN_TEXT_PROMPT   → override the removal instruction without a redeploy
FAL_CLEAN_TEXT_MODEL_ID=
FAL_CLEAN_TEXT_PROMPT=

# Cloudflare Workers AI — STANDALONE provider (api/_lib/cloudflareAi.ts).
# NOT wired to any app flow yet (2026-07-18 decision): provisioned + smoke-
# tested only; a separate approved plan is required before any task uses it.
# Cloudflare hosts the model + GPUs; we only call their API.
# Full setup/rotation/pricing doc: docs/cloudflare-workers-ai.md
#   CLOUDFLARE_ACCOUNT_ID  → the company Cloudflare account id (dashboard → account home)
#   CLOUDFLARE_API_TOKEN   → scoped token "wassel-workers-ai-qwen":
#                            Account / Workers AI / Read + Edit on THIS account
#                            only. NEVER the Global API Key.
#   CLOUDFLARE_AI_MODEL    → default @cf/qwen/qwen3-30b-a3b-fp8
#   CLOUDFLARE_AI_BASE_URL → default https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
#                            ({ACCOUNT_ID} is substituted automatically)
# Free plan = 10,000 Neurons/day; when exhausted, requests FAIL with an error
# until the daily UTC reset (no silent billing on the free plan).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_BASE_URL=
