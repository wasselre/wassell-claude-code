{
  "name": "wassell-deck-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Always-on Fly.io worker that drains the deck_jobs queue and runs Anthropic Skills + code_execution to build Wassel-branded .pptx files. Replaces the Vercel Edge function whose 300s timeout was killing real generations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:ingest": "tsx src/ingest/adapters/aqar.selfcheck.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@supabase/supabase-js": "^2.49.1",
    "docx": "^9.7.1",
    "playwright-core": "^1.61.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
