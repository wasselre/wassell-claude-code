# Kimi K3 coder credentials — TEMPLATE.
# Copy this to .kimi.env.local (git-ignored) in each worktree and fill in the key.
#   cp .kimi.env.example .kimi.env.local
# Consumed by scripts/kimi-code.sh, which maps these into ANTHROPIC_* env vars
# for the coder SUBPROCESS only (your Claude session stays on Claude).
KIMI_API_KEY=sk-your-moonshot-key-here
KIMI_MODEL=kimi-k3
# Optional. Claude Code doesn't recognize Kimi model names, so it assumes a 200k
# context window and warns on every run. Set this to the model's real window to
# silence the warning and let auto-compact use the full budget.
# KIMI_MAX_CONTEXT_TOKENS=262144
