# Copy to daemon/.env and fill in real values. The daemon loads this file via
# dotenv; never commit the populated version (daemon/.gitignore excludes it).

# Supabase URL — matches the one in the frontend's .env (VITE_SUPABASE_URL).
SUPABASE_URL=https://your-project.supabase.co

# Service-role key — NOT the anon key. The daemon needs to bypass RLS to run
# the claim_next_presentation_job RPC cleanly (FOR UPDATE SKIP LOCKED under
# the anon/authenticated roles would be blocked or race in subtle ways).
# Find it in the Supabase dashboard → Project Settings → API → service_role.
# TREAT THIS KEY AS A PASSWORD. Anyone with it can read/write your entire DB.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Path to the `claude` CLI. Leave empty to use whichever `claude` is on PATH.
# On Windows you can use either a POSIX path or a Windows path.
CLAUDE_BIN=

# Where template manifests live. Each subfolder with a template.json is a
# template. Defaults to `~/.claude/ppt/templates` (expanded at runtime).
TEMPLATES_DIR=

# Poll interval in milliseconds (default 5000 = 5 seconds).
POLL_INTERVAL_MS=5000

# Heartbeat interval in ms (default 15000 = 15 seconds). Must be < 60s — the
# app treats last_seen > 60s as "offline".
HEARTBEAT_INTERVAL_MS=15000

# Max run time per job before the daemon kills it, in seconds (default 1800 = 30 min).
JOB_TIMEOUT_SECONDS=1800

# Directory for rotating daemon logs. Relative paths resolve against the
# daemon folder (so `logs` means `daemon/logs`). One file per day, files
# older than 7 days deleted on boot. Default is `logs`.
LOG_DIR=

