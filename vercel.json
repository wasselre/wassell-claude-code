{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ':!docs/prd/models' ':!docs/prd/workflows'",
  "rewrites": [
    { "source": "/((?!api/)(?!assets/)(?!manifest\\.webmanifest$)(?!sw\\.js$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/:name(.+-[A-Za-z0-9_-]{8,}\\.(?:js|css|woff2?|ttf|otf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/:name(.+\\.(?:png|jpg|jpeg|gif|webp|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/sweep-due-followups", "schedule": "*/5 * * * *" },
    { "path": "/api/sweep-appointment-noshows", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/watchdogs", "schedule": "*/5 * * * *" }
  ]
}
