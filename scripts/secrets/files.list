# Files carried in the encrypted secrets bundle.
#
# Format:  <root>:<relative path>
#   repo:  resolved against the MAIN git working tree (seal) / the CURRENT
#          working tree (unseal) — so unsealing inside a worktree fixes the
#          long-standing "worktrees have no .env" problem.
#   home:  resolved against $HOME.
#
# Lines starting with # and blank lines are ignored.
# A file listed here but missing at seal time is skipped with a warning —
# it is never silently dropped.

repo:.env
repo:.env.local
repo:.deploy-secrets.local
home:.fly/config.yml

# Kimi K3 coder key (KIMI_API_KEY / KIMI_MODEL). Carried from $HOME, not the
# repo root: kimi-code.sh falls back to $HOME, so one copy serves every
# worktree and every cloud session instead of a per-worktree duplicate.
home:.kimi.env.local
