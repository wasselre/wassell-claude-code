{
  "name": "wassell-presentations-cloud-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud worker that polls Supabase for queued presentation jobs and runs them against the Anthropic API. Replaces the local Claude-Code-driven daemon. See docs/prd/presentations.md.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "oauth-init": "tsx src/oauth-init.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@googleapis/drive": "^20.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
