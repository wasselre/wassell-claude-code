# cloud-worker/.env.example
#
# Copy this to cloud-worker/.env when running locally for development.
# In production (Fly.io / Railway / etc.) set these as environment secrets,
# not in a .env file. The .gitignore in this folder excludes .env.

# --- Supabase (REQUIRED) ---
# The cloud worker uses the service-role key to claim jobs and write status.
# NEVER ship the service-role key to the browser; it bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic API (REQUIRED) ---
# The worker calls the Anthropic API directly via @anthropic-ai/sdk.
# This replaces the local `claude --print` invocation the old daemon used.
ANTHROPIC_API_KEY=

# --- Google Drive OAuth (OPTIONAL — needed for the drive_upload tool) ---
# OAuth client (Desktop app type) created at:
#   console.cloud.google.com → Google Auth Platform → Clients → + Create Client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The refresh token is captured by `npm run oauth-init` — that's a one-time
# browser flow. The script writes the value here automatically. Don't edit.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Drive folder ID where new decks land (the chunk after /folders/ in the
# folder URL). Optional — when blank, uploads land in the OAuth user's
# root Drive.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- Tuning (OPTIONAL) ---
# How often to poll for queued jobs when idle.
POLL_INTERVAL_MS=5000
# How often to upsert the heartbeat into daemon_status.
HEARTBEAT_INTERVAL_MS=15000
# Max wall-clock seconds for a single job before we cancel it.
JOB_TIMEOUT_SECONDS=1800
