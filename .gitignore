# ────────────────────────────────────────────────────────────────────
# Wassell CRM — .gitignore
# Keeps secrets, build output, and heavy assets out of the repo.
# ────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
# Exception: the activity-log source directory (case-insensitive matches `logs/`
# on Windows / macOS and was being ignored).
!src/pages/Logs/
*.log

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude / local scratch
.claude/settings.local.json
.claude/plans/
.claude/hooks/*.log

# Heavy brand assets (kept outside the production bundle)
Wassel Branding/
Wassel\ Branding/

# Unrelated side project that happens to live in this folder — NOT part of Wassell.
# It's a separate Supabase Edge Function (haberchat-webhook / WhatsApp bot). Keep
# it out of the Wassell repo so the two projects don't get tangled. Everything
# else under supabase/functions/ (the marketing pipeline agents + the inbox +
# _shared helpers) IS part of Wassell and lives in git.
supabase/functions/haberchat-webhook/
# Deno lock/cache noise inside function dirs
supabase/functions/**/deno.lock
supabase/functions/**/.deno/

# TypeScript build info
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# OS junk
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
.vercel
.env*.local
tmp/
dbq.tmp.mjs

# Cached raw Overpass responses for the geo-intelligence builds — regenerable
# via `node data/source/geo/fetch.mjs` (12 MB+, and re-fetching is the point of
# having the cache locally, not of shipping it).
data/source/geo/raw/
data/source/geo-uae/raw/

# Cached OSM admin-boundary relations (country/region) — regenerable via
# `node data/source/geo/fetch-admin.mjs`.
data/source/geo/raw-admin/

# Geo build outputs that are pure derivatives of
# data/source/geo/saudi-cities-geo-intelligence.json (which IS committed — it is
# what the importer consumes). Regenerate with `node data/source/geo/process.mjs`.
data/source/geo/saudi-cities-geo-intelligence.geojson
data/source/geo/saudi-cities-geo-intelligence.csv
# 9.6 MB intermediate: the OSM admin relations are already imported into
# geo_admin_boundaries, and `node data/source/geo/fetch-admin.mjs` rebuilds it.
data/source/geo/admin-boundaries.json
docs/marketing-reference/tools/node_modules/
docs/marketing-reference/tools/render-page.html
